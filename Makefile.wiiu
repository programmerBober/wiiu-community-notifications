#-------------------------------------------------------------------------------
# Wii U WUPS Plugin Makefile
#-------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

TOPDIR ?= $(CURDIR)
include $(DEVKITPRO)/wups/share/wups_rules

WUT_ROOT := $(DEVKITPRO)/wut
WUPS_ROOT := $(DEVKITPRO)/wups

TARGET := CommunityNotifications
BUILD := build_wiiu
CXX := $(DEVKITPPC)/bin/powerpc-eabi-g++

CXXFLAGS := -std=c++20 -O2 -Wall -DESPRESSO -mcpu=750 -meabi -mhard-float \
            -ffunction-sections -fdata-sections \
            -D__WIIU__ -D__WUT__ -D__WUPS__ \
            -Iinclude -Isrc \
            -I$(WUPS_ROOT)/include -I$(WUT_ROOT)/include -I$(WUT_ROOT)/usr/include

LDFLAGS := $(RPXSPECS) $(WUPSSPECS) \
           -L$(WUPS_ROOT)/lib -L$(WUT_ROOT)/usr/lib -L$(WUT_ROOT)/lib \
           -lwups -lnotifications -lwut

SRCS := src/main.cpp src/drc_led_controller.cpp src/notification_config.cpp \
        src/notification_feed.cpp src/notifications_overlay.cpp

.PHONY: all clean

all: $(TARGET).wps

$(TARGET).elf: $(SRCS)
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) $(SRCS) $(LDFLAGS) -o $@

clean:
	rm -rf $(BUILD) $(TARGET).elf $(TARGET).wps
